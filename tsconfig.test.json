{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": false,
    "outDir": "./dist-test",
    "rootDir": ".",
    "skipLibCheck": true,
    "allowJs": false,
    "types": ["node"],
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "electron/services/broadcastBlocks.ts",
    "electron/services/crtShaders.ts",
    "electron/services/crtFilterRuntime.ts",
    "src/utils/episodeBlocks.ts",
    "test/**/*.ts"
  ]
}
