{
  "appId": "com.analogreplaytv.app",
  "productName": "AnalogReplayTV",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AnalogReplayTV",
    "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.video",
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
  },
  "dmg": {
    "title": "AnalogReplayTV ${version}"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "AudioVideo",
    "synopsis": "AnalogReplayTV",
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
  }
}
